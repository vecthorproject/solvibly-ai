# Copy to backend/.env and fill in. Never commit the real .env.

# --- AI used to read uploaded statements ---
# claude (default) or gemini. If empty, Claude is used when ANTHROPIC_API_KEY is set,
# otherwise Gemini when GEMINI_API_KEY is set.
AI_PROVIDER=claude

# Claude (Anthropic API, https://platform.claude.com). Data sent through the API is not
# used to train models (Anthropic Commercial Terms).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high: how much the model reasons before answering (medium = model default).
CLAUDE_EFFORT=medium

# Gemini (optional alternative). When the app is offered to users in the EU/EEA,
# Switzerland or the UK, Google's terms allow only the paid services.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Server ---
# Comma-separated list of frontend origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development server only. Keep 0 in production (use gunicorn: gunicorn app:app).
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# --- Client archive (accounts, clients, saved analyses) ---
# Postgres connection string, e.g. from Neon (free tier, choose an EU region):
#   postgresql://user:password@host/dbname?sslmode=require
# Empty locally: a SQLite file in backend/data/ is used. Empty on Render: the archive is disabled
# (Render's disk is wiped at every deploy), analyses still work.
DATABASE_URL=
# Long random string used to sign login tokens. Required in production; if it changes, everyone
# is logged out. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
